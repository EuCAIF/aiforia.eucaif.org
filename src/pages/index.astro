---
import Layout from '../layouts/Layout.astro';
import '../styles/global.css';
---

<Layout title="AIFORIA – EuCAIF">

<header class="top">
  <div class="top-inner">
    <a class="brand" href="https://eucaif.org">
      <img src="/images/eucaif-logo-icon.png" alt="" width="34" height="34" />
      EuCAIF
    </a>
    <a class="top-link" href="https://eucaif.org">eucaif.org →</a>
  </div>
</header>

<main class="hero">
  <div class="hero-inner">
    <p class="label">EuCAIF</p>
    <h1>AIFORIA</h1>
    <p class="lead">An initiative of EuCAIF, the European Coalition for AI in Fundamental Physics.</p>
    <p class="note">This page is under construction. More information will appear here soon.</p>
    <a class="btn" href="https://eucaif.org">Visit eucaif.org</a>
  </div>
</main>

<footer>
  <div class="footer-inner">
    <span>© {new Date().getFullYear()} EuCAIF – European Coalition for AI in Fundamental Physics</span>
    <a href="mailto:info@eucaif.org">info@eucaif.org</a>
  </div>
</footer>

</Layout>
